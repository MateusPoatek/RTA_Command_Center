%% D-15 Rollout Waves
%% Source: docs/engineering/CONNECTOR_CATALOG.md; folds in 03-integration-rest-readonly.mmd + 04-integration-citrix-vdi.mmd
%% Purpose: five capture tiers as rollout waves, all feeding one adapter-blind core (P2)

flowchart LR

    subgraph T1 ["WAVE 1 — Tier 1: Native APIs"]
        direction TB
        T1env["Applies when: read-only Verint<br/>REST credential is granted<br/>(any environment — Citrix becomes<br/>irrelevant to capture)"]
        T1mech["Verint REST API (Track B)<br/>OAuth client-credentials (vault token)<br/>Poll every 60s — no push channel<br/>backoff + circuit breaker<br/>GET-only by construction"]
        T1fid["Effort: low (once credentialed)<br/>Fidelity: highest — LOB native,<br/>no pixels, no OCR<br/>Status: designed, needs credential"]
        T1env --> T1mech --> T1fid
    end

    subgraph T2 ["WAVE 2 — Tier 2: Hybrid"]
        direction TB
        T2env["Applies when: API access is partial<br/>or rate-limited — needs a<br/>batch-reconciliation companion"]
        T2mech["Verint REST (primary, real-time) +<br/>File Export / GScript<br/>(scheduled batch backfill)"]
        T2fid["Effort: medium<br/>Fidelity: high; batch leg adds latency<br/>Status: designed, not built"]
        T2env --> T2mech --> T2fid
    end

    subgraph T3 ["WAVE 3 — Tier 3: Browser Extension"]
        direction TB
        T3env["Applies when: Verint is web-accessible<br/>('just a browser' — EPIC).<br/>Does NOT work in Citrix."]
        T3mech["RTA Live Bridge (MV3)<br/>hooks Verint's own fetch/XHR,<br/>parses calendar-filter,<br/>bridges via postMessage"]
        T3fid["Effort: low-medium<br/>Fidelity: high — same-machine PII,<br/>networked relay needs a PII decision<br/>Status: live-proven on EPIC"]
        T3env --> T3mech --> T3fid
    end

    subgraph T4 ["WAVE 4 — Tier 4: Citrix / VDI"]
        direction TB
        T4env["Applies when: Verint reachable only<br/>as a Citrix pixel stream, no API<br/>credential — no data copy-out"]
        T4mech["RPA Engine (in-boundary)<br/>deterministic writes only<br/>+ Approved egress<br/>(VDI-compatible agent / TELUS email)<br/>— raw pixels never leave"]
        T4fid["Effort: high (governance + infra gate)<br/>Fidelity: depends on Tier 5 capture leg<br/>Status: designed"]
        T4env --> T4mech --> T4fid
    end

    subgraph T5 ["WAVE 5 — Tier 5: OCR / Vision"]
        direction TB
        T5env["Applies when: no API, no extension —<br/>the only local option inside the VDI"]
        T5mech["Vision/OCR Agent (Track A)<br/>screenshot -> OCR/vision engine,<br/>captured IN-VDI<br/>LOB injected from tab/filter context<br/>(never OCR'd)"]
        T5fid["Effort: highest — needs classifier<br/>fine-tuned on 200-500 labeled screens<br/>Fidelity: status 100% · name 75% ·<br/>duration 75% · LOB 0%<br/>Status: baseline only"]
        T5env --> T5mech --> T5fid
    end

    T1 -. "next wave" .-> T2
    T2 -. "next wave" .-> T3
    T3 -. "next wave" .-> T4
    T4 -. "next wave" .-> T5

    Row["normalized snapshot<br/>AgentRow[]<br/>(agent_id · name · lob[from config] ·<br/>geo · status · scheduled · duration_s · adherence%)"]

    subgraph CORE ["STABLE RULES CORE — adapter-blind<br/>(P2: same core serves every tier, only<br/>the capture adapter changes)"]
        direction TB
        N["verint_normalize"]
        T["verint_triage<br/>consumes Verint's own OOA verdict"]
        B["card_builder"]
        N --> T --> B
    end

    Card["CommandCard[]<br/>-> Command Center (HITL)"]

    T1fid --> Row
    T2fid --> Row
    T3fid --> Row
    T4fid --> Row
    T5fid --> Row
    Row --> N
    B --> Card

    classDef wave1 fill:#eef2ff,stroke:#6366f1,stroke-width:2px,color:#3730a3
    classDef wave2 fill:#eef2ff,stroke:#818cf8,color:#3730a3
    classDef wave3 fill:#f1f5f9,stroke:#94a3b8,color:#1e293b
    classDef wave4 fill:#fef2f2,stroke:#dc2626,stroke-width:2px,color:#7f1d1d
    classDef wave5 fill:#fff7ed,stroke:#ea580c,color:#7c2d12
    classDef core  fill:#fefce8,stroke:#64748b,stroke-width:2px,color:#1e293b
    classDef contract fill:#ffffff,stroke:#0ea5e9,stroke-width:2px,color:#0c4a6e

    class T1env,T1mech,T1fid wave1
    class T2env,T2mech,T2fid wave2
    class T3env,T3mech,T3fid wave3
    class T4env,T4mech,T4fid wave4
    class T5env,T5mech,T5fid wave5
    class N,T,B core
    class Row,Card contract
