%% D-19 Migration Waves
%% Source: Golden_Cluster_Calculations/ACCOUNT_SELECTION_METHODOLOGY.md (§2, §2A, §7)
%% Purpose: account onboarding sequenced by Gold/Silver/Bronze tiering; each wave = new tenant manifest, not a code change (P3)

flowchart LR

    subgraph W1 ["WAVE 1 — Gold: Golden Cluster"]
        direction TB
        W1crit["Verint sched+adherence AND<br/>GTT time-capture AND Workday payroll,<br/>ALL TI-owned (not client/Citrix)"]
        W1size["20 accounts · 6,768 HC · ~68 RTAs<br/>3 regions (Americas/Europe/APAC)<br/>5 accounts at $0 HC today"]
        W1val["$242K–$660K/yr recoverable<br/>(conservative–aggressive)<br/>Status: ready today, no negotiation needed"]
        W1crit --> W1size --> W1val
    end

    subgraph W2 ["WAVE 2 — Silver: partial stack"]
        direction TB
        W2crit["At least 2 of 3 systems present<br/>(Verint / GTT / Workday), NOT<br/>Citrix/VDI-locked, NOT PCI-flagged"]
        W2size["85 accounts (candidate) · 12,258 HC<br/>corrected 2026-07-08, bank-tier client removed<br/>Citrix/PCI status not yet re-verified<br/>per account"]
        W2val["Capture tier likely shifts per account<br/>(D-15 Tier 2/3 hybrid or extension)<br/>Status: candidate list, not individually cleared"]
        W2crit --> W2size --> W2val
    end

    subgraph W3 ["WAVE 3 — Bronze: locked/different stack"]
        direction TB
        W3crit["Fewer than 2 of 3 systems, OR<br/>confirmed Citrix/VDI-locked, OR<br/>confirmed PCI-restricted"]
        W3size["Seed list only, NOT fully sized:<br/>bank-tier client A (839 HC, Bronze), BMO, MasterCard,<br/>MoneyGram, CoreLogic (252 HC),<br/>T-Mobile (387 HC), United Healthcare<br/>— known HC 1,478 of an unknown total"]
        W3val["Needs negotiation or a different<br/>capture strategy (D-15 Tier 4/5) before<br/>reachable at all<br/>Status: not sized — do not commit a date"]
        W3crit --> W3size --> W3val
    end

    W1 -. "next wave" .-> W2
    W2 -. "next wave" .-> W3

    Manifest["Onboarding an account = authoring<br/>one new tenant manifest (P3)<br/>— zero code change, same OCI image,<br/>same adapter-blind rules core"]

    W1val --> Manifest
    W2val --> Manifest
    W3val --> Manifest

    Core["STABLE PLATFORM<br/>(D-15 capture tiers + D-11 rules core)<br/>unaffected by which wave an account is in"]

    Manifest --> Core

    classDef wave1 fill:#eef2ff,stroke:#6366f1,stroke-width:2px,color:#3730a3
    classDef wave2 fill:#f1f5f9,stroke:#94a3b8,color:#1e293b
    classDef wave3 fill:#fef2f2,stroke:#dc2626,stroke-width:2px,color:#7f1d1d
    classDef contract fill:#ffffff,stroke:#0ea5e9,stroke-width:2px,color:#0c4a6e
    classDef core fill:#fefce8,stroke:#64748b,stroke-width:2px,color:#1e293b

    class W1crit,W1size,W1val wave1
    class W2crit,W2size,W2val wave2
    class W3crit,W3size,W3val wave3
    class Manifest contract
    class Core core
