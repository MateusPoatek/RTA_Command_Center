%% D-06 Platform Capability Stack
%% Source: recast from docs/engineering/diagrams/mmd/01-system-architecture-cloud-neutral.mmd
%% Purpose: the platform as five layers (Presentation/AI/Business/Integration/Infrastructure)

flowchart TB

    %% ── Presentation ───────────────────────────────────────────────────
    subgraph PRES ["Presentation Layer"]
        direction LR
        SPA["RTA Command Center<br/>React SPA — HITL review"]
    end

    %% ── AI (P1: read-only / advise, no write credentials) ──────────────
    subgraph AI ["AI Layer  (advise/draft only — no write path, P1)"]
        direction LR
        LLM["LLM Endpoint<br/>advise / draft only"]
    end

    %% ── Business Services (P2: adapter-blind rules core) ────────────────
    subgraph BIZ ["Business Services Layer  (adapter-blind, P2)"]
        direction TB
        Gateway["API Gateway<br/>OIDC · MFA · RBAC · rate-limit · request validation"]
        subgraph CORE ["Stable Rules Core"]
            direction LR
            Normalize["verint_normalize"]
            Triage["verint_triage<br/>(consumes Verint OOA verdict)"]
            Builder["card_builder"]
            Normalize --> Triage --> Builder
        end
        Push["Push Service<br/>WSS / SSE"]
        Dispatch["Dispatch Workers<br/>(swappable adapters)"]
        Control["Control Plane<br/>tenant manifest · registry · preflight"]
        Gateway --> Normalize
        Builder --> Push
        Builder --> Dispatch
    end

    %% ── Integration (capture in, dispatch out) ──────────────────────────
    subgraph INTEG ["Integration Layer"]
        direction LR
        subgraph CAP ["Capture Adapters (one chosen per environment)"]
            direction TB
            Ext["Browser Extension<br/>RTA Live Bridge"]
            Rest["Verint REST<br/>read-only (Track B)"]
            Vision["Vision / OCR<br/>in-VDI (Track A)"]
            Netcap["netcap<br/>Playwright/CDP"]
            GScript["File Export<br/>GScript (batch)"]
        end
        subgraph OUT ["Dispatch Targets"]
            direction TB
            Chat["Google Chat<br/>per-LOB"]
            Teams["Microsoft Teams"]
            SNOW["ServiceNow<br/>REST"]
            RPA["RPA Engine<br/>(only write channel into Verint)"]
            Audit["Audit-only"]
        end
    end

    %% ── Infrastructure (P4: five cloud-neutral seams) ───────────────────
    subgraph INFRA ["Infrastructure Layer  (cloud-neutral seams, P4)"]
        direction LR
        Vault["Secret Vault"]
        OpStore["Operational + Audit Store<br/>append-only / WORM"]
        IntelStore["Intelligence Store<br/>(per-tenant)"]
        Runtime["Runtime + Gateway"]
    end

    %% ── Edges ────────────────────────────────────────────────────────────
    Ext --> Gateway
    Rest --> Gateway
    Vision --> Gateway
    Netcap --> Gateway
    GScript --> Gateway

    Push --> SPA
    SPA -- "approve (human)" --> Gateway

    Dispatch --> Chat
    Dispatch --> Teams
    Dispatch --> SNOW
    Dispatch --> RPA
    Dispatch --> Audit

    Control -. "configures" .-> CAP
    Control -. "configures" .-> Dispatch

    Builder -. "advise/draft only" .-> LLM
    LLM -. "no write path" .-> Builder

    BIZ -. "binds" .-> Vault
    BIZ -. "binds" .-> OpStore
    BIZ -. "binds" .-> IntelStore
    BIZ -. "binds" .-> Runtime
    AI -. "binds" .-> Runtime

    %% ── Styles ───────────────────────────────────────────────────────────
    classDef pres     fill:#eef2ff,stroke:#4f46e5,stroke-width:2px,color:#3730a3
    classDef ai        fill:#fdf4ff,stroke:#a855f7,stroke-dasharray:3 2,color:#581c87
    classDef core      fill:#fefce8,stroke:#64748b,color:#1e293b
    classDef capture   fill:#eef2ff,stroke:#6366f1,color:#3730a3
    classDef out       fill:#f1f5f9,stroke:#94a3b8,color:#1e293b
    classDef seam      fill:#f0fdf4,stroke:#16a34a,stroke-dasharray:5 3,color:#14532d

    class SPA pres
    class LLM ai
    class Normalize,Triage,Builder,Gateway,Push,Dispatch,Control core
    class Ext,Rest,Vision,Netcap,GScript capture
    class Chat,Teams,SNOW,RPA,Audit out
    class Vault,OpStore,IntelStore,Runtime seam
