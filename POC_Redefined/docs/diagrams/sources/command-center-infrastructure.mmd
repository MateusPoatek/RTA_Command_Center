%% RTA Command Center — Infrastructure Diagram
%% Grounds the architecture in the concrete Telus Digital GCP hosting decision (2026-07-06).
%% Cost anchors are annotated so the diagram survives the "where are the costs" review.

subgraph wfmNetwork ["WFM Network (source systems)"]
  verintTenant["Verint WFM tenant\nwfo.a87.verintcloudservices.com\ncalendar-filter API"]
  gttApi["GTT ATOS Report API\n(GCP-hosted, SA identity token)"]
  niceIex["NICE IEX\n(expansion — 2nd WFM vendor)"]
end

subgraph legacyGcp ["Telus International GCP — DECOMMISSIONING (migrate off)"]
  legacyProjects["Legacy WFM/RPA projects\n→ migrate to Telus Digital GCP\nunder Cloud COE (tighter security)"]
end

subgraph telusDigital ["Telus Digital GCP — target project (non-prod, IaC / Terraform)"]

  subgraph runtimeTier ["Compute / Runtime"]
    cloudRun["Cloud Run\ncapture + reconciliation services"]
    cloudScheduler["Cloud Scheduler\nper-tenant report cron"]
    cloudTasks["Cloud Tasks\ndispatch queue (retry/idempotency)"]
  end

  subgraph messagingTier ["Messaging"]
    pubsub["Pub/Sub\nevent fan-out"]
  end

  subgraph dataTier ["Data / State"]
    cloudSql["Cloud SQL (PostgreSQL)\noperational + config state"]
    firestore["Firestore\nimmutable audit (WORM, hash-chained)"]
    cloudStorage["Cloud Storage\nreport / artefact store (≥90d)"]
    secretManager["Secret Manager\nVerint token, GTT SA key, webhook URLs"]
  end

end

subgraph existingPlatform ["Existing Telus platform (reuse) — Anshul Gaddoo"]
  aaControlRoom["Automation Anywhere Control Room\norchestrator · ~18 VMs · ~125 bots"]
  intelligentInsights["Intelligent Insights\nobservability + audit spine\nSOC 2 Type II · PostgreSQL"]
end

subgraph dispatch ["Dispatch / Consumers"]
  chatSheets["Google Chat / Sheets webhooks\n(existing — reuse)"]
  commandCenterUi["Command Center UI\nRTA Floor View + HITL gate"]
end

%% Connectivity — the gating unknown
verintTenant -->|"read (extension relay / REST)"| cloudRun
gttApi -->|"SA identity token"| cloudRun
niceIex -.->|"capture adapter (expansion)"| cloudRun
wfmNetwork -.->|"⚠ GATING UNKNOWN:\nWFM-network connectivity\nmust be confirmed (AD-009, R-11)"| telusDigital

%% Migration
legacyProjects -.->|"IaC migration"| telusDigital

%% Internal wiring
cloudScheduler --> cloudRun
cloudRun --> pubsub
pubsub --> cloudTasks
cloudRun --> cloudSql
cloudRun --> firestore
cloudRun --> cloudStorage
cloudRun --> secretManager
cloudTasks -->|"HITL-gated"| chatSheets
cloudRun --> commandCenterUi

%% Reuse of existing spine
aaControlRoom -.->|"orchestrates"| cloudRun
firestore -.->|"logs / metrics / exceptions"| intelligentInsights
cloudRun -.->|"telemetry"| intelligentInsights

subgraph costAnchor ["Cost anchors (2026-07-06 review)"]
  c1["Incumbent AA bot: ~$12–13K / bot / yr"]
  c2["Shared-services: ~$3 CAD / VM-hr + ~$15–16K / yr / bot (L1–L3)"]
  c3["New GCP project budget: $500 initial (adjustable)"]
  c4["Reuse existing spine → avoid duplicating run-cost (BO-07)"]
end

