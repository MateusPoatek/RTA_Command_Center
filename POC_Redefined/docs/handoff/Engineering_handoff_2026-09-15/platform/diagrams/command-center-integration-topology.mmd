%% Ingestion flows
verintWFM -->|"API response tee (extension)\nor REST API (production)"| verintConnector
niceIEX -.->|"capture adapter (expansion)"| niceConnector
gttSystem -->|"ATOS Report API\nor direct feed"| gttConnector
tableauServer -->|"Looker/Tableau API\n(11:30am refresh)"| tableauConnector

%% AI processing
verintConnector --> alertEngine
niceConnector -.-> alertEngine
gttConnector --> alertEngine
tableauConnector --> alertEngine
alertEngine --> anaBot
anaBot --> cardBuilder
cardBuilder --> copilot

%% Orchestration (reuse existing)
aaControlRoom -.->|"orchestrates jobs"| alertEngine
aaControlRoom -.->|"orchestrates jobs"| cardBuilder

%% Human gate
cardBuilder --> rtaDecision
copilot --> rtaDecision
alertEngine --> floorView
rtaDecision --> auditTrail
rtaDecision --> learningSignals

%% Observability + audit into existing spine (reuse)
auditTrail -.->|"logs / exceptions / STP metrics"| intelligentInsights
floorView -.->|"telemetry"| intelligentInsights
intelligentInsights -.->|"scheduled reports"| emailDispatch

%% Dispatch
rtaDecision -->|"Approved"| gchatDispatch
rtaDecision -->|"Approved"| teamsDispatch
rtaDecision -->|"Report ready"| emailDispatch

%% Bi-directional integrations
rtaDecision -.->|"Create / update ticket"| serviceNow
serviceNow -.->|"Ticket status updates"| cardBuilder
rtaDecision -.->|"Absence justification"| workday
workday -.->|"PTO / absence records"| cardBuilder
awsConnect -.->|"Queue depth + IVR stats"| alertEngine
googleSheets -.->|"Roster + allocation data"| cardBuilder

subgraph legend ["Legend"]
  l1["Solid arrow = Active data flow"]
  l2["Dashed arrow = Bi-directional / planned / expansion"]
  l3["Blue nodes = existing Telus platform (reuse, not rebuilt)"]
