%% Connector Fail-Prevention — defense-in-depth & fallback layering
%% Source: POC_Redefined/docs/engineering/CONNECTOR_CATALOG.md,
%%         POC_Redefined/docs/CAPTURE_AND_DISPATCH_ADAPTERS.md
%% Description: How capture adapters layer for resilience per environment. The
%%              chosen primary degrades to fallbacks; any unparseable row becomes
%%              an exception card to HITL; multi-source confirmation corroborates
%%              before a card is trusted; every step is audited.
%% Rendered by: mmdc (Mermaid CLI) or https://mermaid.live

flowchart TB

    subgraph CIBC ["No-access tier (CIBC / Citrix)"]
        direction TB
        C1["1. Verint REST (Track B)\nPRIMARY — if credential granted"]
        C2["2. Vision/OCR in-VDI (Track A)\nFALLBACK"]
        C3["3. File export (GScript)\nEMERGENCY batch"]
        C1 -. "unavailable" .-> C2
        C2 -. "unavailable" .-> C3
    end

    subgraph EPIC ["Full/partial-access tier (EPIC / web Verint)"]
        direction TB
        E1["1. Browser Extension\nPRIMARY"]
        E2["2. netcap (Playwright/CDP)\nALTERNATIVE / test"]
        E3["3. Verint REST\nif credentialed"]
        E1 -. "unavailable" .-> E2
        E2 -. "unavailable" .-> E3
    end

    Norm["normalize\n(AgentRow[])"]
    Conf{"row normalizes?"}
    Except["Exception card\nconfidence 0.0\ntargetChannels: audit-only\n-> HITL review"]
    Multi["Multi-source confirmation\n(see diagram 06)"]
    Trust["Trusted CommandCard\n-> Command Center"]
    Audit["Append-only audit trail\n(agreement & disagreement both logged)"]

    C1 --> Norm
    C2 --> Norm
    C3 --> Norm
    E1 --> Norm
    E2 --> Norm
    E3 --> Norm
    Norm --> Conf
    Conf -- "no" --> Except
    Conf -- "yes" --> Multi
    Multi --> Trust
    Except -. "logged" .-> Audit
    Trust -. "logged" .-> Audit
    Multi -. "logged" .-> Audit

    classDef cibc fill:#fef2f2,stroke:#dc2626,color:#7f1d1d
    classDef epic fill:#eef2ff,stroke:#6366f1,color:#3730a3
    classDef core fill:#fefce8,stroke:#64748b,color:#1e293b
    classDef warn fill:#fff7ed,stroke:#ea580c,color:#7c2d12
    classDef store fill:#f0fdf4,stroke:#16a34a,color:#14532d

    class C1,C2,C3 cibc
    class E1,E2,E3 epic
    class Norm,Conf,Multi,Trust core
    class Except warn
    class Audit store
