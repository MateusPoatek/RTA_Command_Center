# Copy to .env (gitignored) and fill in real values. local_api.py reads these
# via os.environ — no dotenv loader wired up, so `export` them in your shell
# or use `env $(cat .env | xargs) .venv-browser/bin/python local_api.py`.

# Google Chat incoming webhook per account. Format: the full webhook URL
# (including its ?key=...&token=... query string — that IS the credential,
# treat it like a password). One var per account, uppercase account name.
GCHAT_WEBHOOK_EPIC=
