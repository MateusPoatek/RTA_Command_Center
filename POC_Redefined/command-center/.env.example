# ============================================================
# RTA Command Center — Environment Variables Template
# ============================================================
#
# How to use:
#   1. Copy this file: cp .env.example .env.local
#   2. Fill in the values below.
#   3. Restart the dev server after changing any value.
#
# ⚠️  SECURITY WARNING
# Variables prefixed with VITE_ are embedded into the browser
# bundle at build time. They are visible in DevTools to anyone
# who opens the app. Never use production secrets here.
#
# For production, use a backend proxy instead.
# See src/services/fuelixClient.ts for the full security note
# and three options for secure key management.
#
# ============================================================

# FuelIX AI API (OpenAI-compatible)
# ----------------------------------
# Base URL of the FuelIX API endpoint.
# Change this if you are using a different OpenAI-compatible provider
# (e.g. Azure OpenAI, Ollama, a CIBC-hosted model gateway).
VITE_FUELIX_BASE_URL=https://api.fuelix.ai/v1

# Your FuelIX API key.
# Leave blank to disable AI features (Copilot panel will show "not configured").
# Ask your team lead for the demo key.
VITE_FUELIX_API_KEY=

# The model to use for Copilot completions.
# gpt-4o-mini is the default — fast and cost-effective for short operational responses.
# Change to gpt-4o for higher quality at higher cost.
VITE_FUELIX_MODEL=gpt-4o-mini
